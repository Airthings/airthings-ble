{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Oslo",
  "schedule": [
    "after 4am and before 11am on the first day of the month"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Anything not matched below stays out of the release notes.",
      "matchPackageNames": ["*"],
      "labels": ["nochangelog"]
    },
    {
      "description": "Runtime dependencies reach Home Assistant users; keep them separate and in the release notes.",
      "matchManagers": ["poetry"],
      "matchDepTypes": ["dependencies"],
      "labels": ["dependencies"]
    },
    {
      "matchManagers": ["poetry"],
      "matchDepTypes": ["dev"],
      "groupName": "development tools",
      "labels": ["nochangelog"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "labels": ["nochangelog"]
    }
  ]
}
